          "expr": "max(last_over_time(github_copilot_monthly_active_users{enterprise=\"$enterprise\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 605,
      "type": "stat",
      "title": "Code Acceptance Rate",
      "description": "Code Acceptance Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
