      "id": 607,
      "type": "timeseries",
      "title": "Adoption Trend",
      "description": "Daily, weekly, and monthly active users over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "github_copilot_daily_active_users{enterprise=\"$enterprise\"}",
          "legendFormat": "DAU",
          "refId": "A"
        },
        {
          "expr": "github_copilot_weekly_active_users{enterprise=\"$enterprise\"}",
          "legendFormat": "WAU",
          "refId": "B"
        },
        {
          "expr": "github_copilot_monthly_active_users{enterprise=\"$enterprise\"}",
          "legendFormat": "MAU",
          "refId": "C"
        }
      ]
    },
