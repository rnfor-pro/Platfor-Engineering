  "description": "Executive view of GitHub Copilot adoption, seat utilization, engineering output, and spend. Focused on leadership-friendly KPIs with recent trends.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 600,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "This executive dashboard summarizes Copilot adoption, seat utilization, engineering output, and spend. Use it to answer four questions: Are licenses being used, are teams engaging, is Copilot driving output, and what is the current cost trend?",
        "mode": "markdown"
      }
    },
    {
      "id": 601,
      "type": "stat",
      "title": "Seat Total",
      "description": "Seat Total",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(last_over_time(github_copilot_enterprise_seat_total{enterprise=\"$enterprise\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
