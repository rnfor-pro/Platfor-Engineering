{
    "__inputs": [
      {
        "name": "DS_VICTORIAMETRICS",
        "label": "VictoriaMetrics",
        "description": "",
        "type": "datasource",
        "pluginId": "prometheus",
        "pluginName": "Prometheus"
      }
    ],
    "__elements": {},
    "__requires": [
      {
        "type": "grafana",
        "id": "grafana",
        "name": "Grafana",
        "version": "10.0.0"
      },
      {
        "type": "datasource",
        "id": "prometheus",
        "name": "Prometheus",
        "version": "1.0.0"
      },
      {
        "type": "panel",
        "id": "timeseries",
        "name": "Time series",
        "version": ""
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "Golden-signal view (traffic, latency, errors, saturation) for the BI Publisher cloud proxy (dil-sa-prod-bi-publisher-cloud-proxy).",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Calls per minute (total) to BI Publisher proxy",
        "description": "Rising call volume indicates increased demand. If volume and latency rise together, risk of saturation increases.",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VICTORIAMETRICS}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "req/min",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "max": 80
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(\n  rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n) * 60",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_VICTORIAMETRICS}"
            },
            "legendFormat": "calls/min"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Calls per minute by caller service",
        "description": "Identifies which service is contributing most to proxy load.",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VICTORIAMETRICS}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "req/min",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "max": 40
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (service_name) (\n  rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n) * 60",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_VICTORIAMETRICS}"
            },
            "legendFormat": "{{service_name}}"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Average latency to BI Publisher proxy",
        "description": "Persistent elevation means user-facing slowdown risk.",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VICTORIAMETRICS}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "seconds",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "max": 60
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(\n  rate({\"http.client.duration_sum\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n)\n/\nclamp_min(\n  sum(\n    rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n  ),\n  0.0001\n)",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_VICTORIAMETRICS}"
            },
            "legendFormat": "avg latency"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Status code mix (calls per minute)",
        "description": "If 2xx remains high while latency worsens, this is a brownout rather than a hard outage.",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VICTORIAMETRICS}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 25,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "normal",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "req/min",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (\"http.status_code\") (\n  rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n) * 60",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_VICTORIAMETRICS}"
            },
            "legendFormat": "status={{http.status_code}}"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Error percentage (4xx + 5xx)",
        "description": "Separates latency-only incidents from true error-rate incidents.",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VICTORIAMETRICS}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "percent",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "max": 100
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "100 *\nsum(\n  rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\",\"http.status_code\"=~\"4..|5..\"}[$__rate_interval])\n)\n/\nclamp_min(\n  sum(\n    rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n  ),\n  0.0001\n)",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_VICTORIAMETRICS}"
            },
            "legendFormat": "error %"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "In-flight approximation (Little's law style)",
        "description": "Rising in-flight plus rising latency suggests queue buildup/saturation.",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VICTORIAMETRICS}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "concurrent requests",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "max": 20
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 12,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "(\n  sum(\n    rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n  )\n)\n*\n(\n  sum(\n    rate({\"http.client.duration_sum\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n  )\n  /\n  clamp_min(\n    sum(\n      rate({\"http.client.duration_count\",\"net.peer.name\"=\"dil-sa-prod-bi-publisher-cloud-proxy.private.azuremicroservices.io\"}[$__rate_interval])\n    ),\n    0.0001\n  )\n)",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_VICTORIAMETRICS}"
            },
            "legendFormat": "in-flight (approx)"
          }
        ],
        "pluginVersion": "10.0.0"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "bi-publisher",
      "golden-signals",
      "proxy"
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "",
    "title": "BI Publisher Proxy Golden Signals",
    "uid": "bi-publisher-proxy-golden-signals",
    "version": 1,
    "weekStart": ""
  }