{
    "__inputs": [
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "description": "",
        "type": "datasource",
        "pluginId": "loki",
        "pluginName": "Loki"
      }
    ],
    "__elements": {},
    "__requires": [
      {
        "type": "grafana",
        "id": "grafana",
        "name": "Grafana",
        "version": "10.0.0"
      },
      {
        "type": "datasource",
        "id": "loki",
        "name": "Loki",
        "version": "1.0.0"
      },
      {
        "type": "panel",
        "id": "timeseries",
        "name": "Time series",
        "version": ""
      },
      {
        "type": "panel",
        "id": "logs",
        "name": "Logs",
        "version": ""
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "Error/retry keyword and severity trends across pmx-wbm-bff-ms, wbm-plant-inventory-ms, wbm-lot-number-ms, r12-receipt-service, with a focused drilldown for XXSW_AR_RECEIPT_DASHBOARD_DM.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Error/retry keyword volume by service",
        "description": "Spikes indicate timeout/retry storms or unstable downstream behavior.",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 15,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "count",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (service_name) (\n  count_over_time(\n    {service_name=~\"pmx-wbm-bff-ms|wbm-plant-inventory-ms|wbm-lot-number-ms|r12-receipt-service\"}\n    |~ \"(?i)(timeout|timed out|prematureclose|connection reset|circuit|pool|retry|exception)\"\n    [$__interval]\n  )\n)",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${DS_LOKI}"
            },
            "legendFormat": "{{service_name}}"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Warning/error trend by detected level",
        "description": "Tracks severity mix shifts during incidents.",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 25,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "normal",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "count",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "insertNulls": false,
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [],
            "showLegend": true
          }
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (detected_level) (\n  count_over_time({service_name=~\".+\"}[$__interval])\n)",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${DS_LOKI}"
            },
            "legendFormat": "{{detected_level}}"
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 3,
        "type": "logs",
        "title": "Report-specific log drilldown",
        "description": "Focused evidence for high-volume report activity.",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        },
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 10
        },
        "targets": [
          {
            "expr": "{service_name=~\".+\"} |= \"XXSW_AR_RECEIPT_DASHBOARD_DM\"",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${DS_LOKI}"
            }
          }
        ],
        "pluginVersion": "10.0.0"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "logs",
      "loki",
      "errors",
      "retries"
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "",
    "title": "Logs Error and Retry Lens",
    "uid": "logs-error-retry-lens",
    "version": 1,
    "weekStart": ""
  }