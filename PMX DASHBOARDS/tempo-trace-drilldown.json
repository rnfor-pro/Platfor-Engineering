{
    "__inputs": [
      {
        "name": "DS_TEMPO",
        "label": "Tempo",
        "description": "",
        "type": "datasource",
        "pluginId": "tempo",
        "pluginName": "Tempo"
      }
    ],
    "__elements": {},
    "__requires": [
      {
        "type": "grafana",
        "id": "grafana",
        "name": "Grafana",
        "version": "10.0.0"
      },
      {
        "type": "datasource",
        "id": "tempo",
        "name": "Tempo",
        "version": "1.0.0"
      },
      {
        "type": "panel",
        "id": "table",
        "name": "Table",
        "version": ""
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "Trace-level drilldown for runDataModel report executions and BI Publisher proxy requests.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
      {
        "id": 1,
        "type": "table",
        "title": "Slow runDataModel traces",
        "description": "Identifies slow report executions and available caller metadata. Useful columns: Trace ID, Start time, Name, Duration, and any available span/resource attributes.",
        "datasource": {
          "type": "tempo",
          "uid": "${DS_TEMPO}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "footer": {
            "show": false,
            "reducer": [
              "sum"
            ],
            "countRows": false,
            "fields": ""
          }
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 10
        },
        "targets": [
          {
            "query": "{ name = \"runDataModel\" && duration > 10s }",
            "queryType": "traceql",
            "refId": "A",
            "datasource": {
              "type": "tempo",
              "uid": "${DS_TEMPO}"
            }
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 2,
        "type": "table",
        "title": "Report path coverage (.xdm/.xdo)",
        "description": "Confirms which report paths are visible in traces. Useful columns: Trace ID, Start time, Name, Duration, span.reportPath.",
        "datasource": {
          "type": "tempo",
          "uid": "${DS_TEMPO}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "footer": {
            "show": false,
            "reducer": [
              "sum"
            ],
            "countRows": false,
            "fields": ""
          }
        },
        "gridPos": {
          "x": 0,
          "y": 10,
          "w": 24,
          "h": 10
        },
        "targets": [
          {
            "query": "{ name = \"runDataModel\" && span.reportPath =~ \".*\\\\.(xdm|xdo)$\" }",
            "queryType": "traceql",
            "refId": "A",
            "datasource": {
              "type": "tempo",
              "uid": "${DS_TEMPO}"
            }
          }
        ],
        "pluginVersion": "10.0.0"
      },
      {
        "id": 3,
        "type": "table",
        "title": "Proxy request trace view",
        "description": "Review proxy-level requests and attribution fields where present. Useful columns: Trace ID, Start time, Name, Duration, and any caller attribution attributes present on the span.",
        "datasource": {
          "type": "tempo",
          "uid": "${DS_TEMPO}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "footer": {
            "show": false,
            "reducer": [
              "sum"
            ],
            "countRows": false,
            "fields": ""
          }
        },
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 10
        },
        "targets": [
          {
            "query": "{ name = \"GET /reports/runDataModel\" }",
            "queryType": "traceql",
            "refId": "A",
            "datasource": {
              "type": "tempo",
              "uid": "${DS_TEMPO}"
            }
          }
        ],
        "pluginVersion": "10.0.0"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "tempo",
      "traces",
      "traceql"
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
