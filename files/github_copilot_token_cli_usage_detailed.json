    {
      "id": 511,
      "title": "Top Models by Prompt Count",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk(12, sum by (model) (sum_over_time(github_copilot_user_model_feature_prompt_count{enterprise=\"$enterprise\"}[$__range])))",
          "instant": true,
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Per-user model+feature prompt counts, summed across users. Reflects which models are most frequently invoked, not raw token volume.",
