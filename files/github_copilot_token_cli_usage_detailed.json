        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#7aa2ff",
                "value": null
              },
              {
                "color": "#d08cff",
                "value": 1
              }
            ]
          },
          "unit": "currencyUSD",
          "displayName": "${__field.labels.organization}"
        },
        "overrides": []
      }
    },
