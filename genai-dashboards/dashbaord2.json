          "w": 12,
          "x": 12,
          "y": 20
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum by (gen_ai_request_model) (increase(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[1d]))",
            "legendFormat": "TotalTokens {{gen_ai_request_model}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "stacking": {
                "mode": "normal"
              }
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "sum"
            ]
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 103,
        "type": "row",
        "title": "Model Performance",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 29
        },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 12,
        "type": "piechart",
        "title": "Model Usage Distribution",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 0,
          "y": 30
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum by (gen_ai_request_model) (increase(gen_ai_client_operation_duration_seconds_count{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[$__range]))",
            "legendFormat": "{{gen_ai_request_model}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "pieType": "donut",
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": [
              "value",
              "percent"
            ]
          },
          "tooltip": {
            "mode": "single"
          }
        },
        "description": "Share of total operations by model \u2014 shows adoption distribution across the models available to your org (e.g. Claude, GPT, Copilot's own models)."
      },
      {
        "id": 13,
        "type": "barchart",
        "title": "Response Duration by Model (Avg / P90)",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 8,
          "y": 30
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "avg by (gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_sum{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[$__range]) / rate(gen_ai_client_operation_duration_seconds_count{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[$__range]))",
            "legendFormat": "Avg Duration {{gen_ai_request_model}}"
          },
          {
            "expr": "histogram_quantile(0.90, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[$__range])))",
            "legendFormat": "P90 Duration {{gen_ai_request_model}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "Average and P90 response duration per model. Use this to compare model speed when deciding which to recommend as default for latency-sensitive workflows."
      },
      {
        "id": 14,
        "type": "barchart",
        "title": "Time to First Token by Model (P50 / P90)",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 16,
          "y": 30
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le, gen_ai_request_model) (rate(gen_ai_server_time_to_first_token_seconds_bucket{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[$__range])))",
            "legendFormat": "P50 TTFT {{gen_ai_request_model}}"
          },
          {
            "expr": "histogram_quantile(0.90, sum by (le, gen_ai_request_model) (rate(gen_ai_server_time_to_first_token_seconds_bucket{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[$__range])))",
            "legendFormat": "P90 TTFT {{gen_ai_request_model}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "P50 and P90 time-to-first-token per model \u2014 the perceived 'snappiness' of each model. A model can have a fast average duration but a slow TTFT if it front-loads reasoning before streaming."
      },
      {
        "id": 104,
        "type": "row",
        "title": "Cost & Tokens",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 39
        },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 15,
        "type": "timeseries",
        "title": "Input vs Output Tokens Over Time",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 40
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum(increase(gen_ai_usage_input_tokens_total{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[1h]))",
            "legendFormat": "Input Tokens"
          },
          {
            "expr": "sum(increase(gen_ai_usage_output_tokens_total{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[1h]))",
            "legendFormat": "Output Tokens"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "fillOpacity": 15,
              "lineWidth": 2
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Input Tokens"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#9C5FE0"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Output Tokens"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#5BA85B"
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "Hourly trend of input vs. output token volume. A widening gap between input and output often signals growing context size (large files, long chat history) rather than longer answers."
      },
      {
        "id": 16,
        "type": "table",
        "title": "Estimated Cost by Model",
        "description": "Requires a cost-per-token recording rule or static multiplier; placeholder expression shown",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 40
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum by (gen_ai_request_model) (gen_ai_usage_input_tokens_total{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}) * 0.000003 + sum by (gen_ai_request_model) (gen_ai_usage_output_tokens_total{gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}) * 0.000015",
            "legendFormat": "{{gen_ai_request_model}}",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          },
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 105,
        "type": "row",
        "title": "Errors",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 48
        },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 17,
        "type": "timeseries",
        "title": "Error Count Over Time by Type",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 49
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum by (error_type) (increase(gen_ai_client_operation_duration_seconds_count{error_type!=\"\", gen_ai_request_model=~\"$model\", service_name=~\"$service_name\"}[1h]))",
            "legendFormat": "{{error_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "fillOpacity": 20,
              "lineWidth": 2,
              "stacking": {
                "mode": "normal"
              }
            },
            "color": {
              "mode": "fixed",
              "fixedColor": "#E0524A"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "sum"
            ]
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "Error counts over time broken out by error_type label (e.g. rate_limit, timeout, auth_failure). Spikes here should correlate with entries in the error log panel to the right."
      },
      {
