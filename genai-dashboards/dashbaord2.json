      {
        "id": 20,
        "type": "table",
        "title": "Recent Copilot Traces (search & drill into Tempo)",
        "description": "Click a trace to drill down into individual spans \u2014 chat, execute_tool, invoke_agent",
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 68
        },
        "datasource": {
          "type": "tempo",
          "uid": "${DS_TEMPO_VAR}"
        },
        "targets": [
          {
            "queryType": "traceqlSearch",
            "filters": [
              {
                "id": "service-name",
                "tag": "service.name",
                "operator": "=~",
                "value": [
                  "$service_name"
                ],
                "valueType": "string"
              },
              {
                "id": "model",
                "tag": "gen_ai.request.model",
                "operator": "=~",
                "value": [
                  "$model"
                ],
                "valueType": "string"
              }
            ],
            "limit": 200,
            "tableType": "traces"
          }
        ],
        "options": {}
      },
      {
        "id": 21,
        "type": "traces",
        "title": "Selected Trace Detail",
        "description": "Drill-down view \u2014 select a trace ID from the table above (link via dashboard variable or panel link) to inspect spans, gen_ai.* attributes, and latency breakdown",
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 77
        },
        "datasource": {
          "type": "tempo",
          "uid": "${DS_TEMPO_VAR}"
        },
        "targets": [
          {
            "query": "${__data.fields[\"traceID\"]}",
