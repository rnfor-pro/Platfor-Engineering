              "value",
              "percent"
            ]
          },
          "tooltip": {
            "mode": "single"
          }
        },
        "description": "Share of total operations by model \u2014 shows adoption distribution across the models available to your org (e.g. Claude, GPT, Copilot's own models)."
      },
      {
        "id": 13,
        "type": "barchart",
        "title": "Response Duration by Model (Avg / P90)",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 8,
          "y": 30
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "avg by (\"gen_ai.request.model\") (rate({__name__=\"gen_ai.client.operation.duration_sum\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}[$__range]) / rate({__name__=\"gen_ai.client.operation.duration_count\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}[$__range]))",
            "legendFormat": "Avg {{gen_ai.request.model}}"
          },
          {
            "expr": "histogram_quantile(0.90, sum by (le, \"gen_ai.request.model\") (rate({__name__=\"gen_ai.client.operation.duration_bucket\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}[$__range])))",
            "legendFormat": "P90 {{gen_ai.request.model}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "Average and P90 response duration per model. Use this to compare model speed when deciding which to recommend as default for latency-sensitive workflows."
      },
      {
        "id": 14,
        "type": "barchart",
        "title": "Time to First Token by Model (P50 / P90)",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 16,
          "y": 30
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=\"copilot_chat.time_to_first_token_bucket\", service_name=~\"$service_name\"}[$__range])))",
            "legendFormat": "P50 TTFT"
          },
          {
            "expr": "histogram_quantile(0.90, sum by (le) (rate({__name__=\"copilot_chat.time_to_first_token_bucket\", service_name=~\"$service_name\"}[$__range])))",
            "legendFormat": "P90 TTFT"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "P50 and P90 time-to-first-token per model \u2014 the perceived 'snappiness' of each model. A model can have a fast average duration but a slow TTFT if it front-loads reasoning before streaming."
      },
