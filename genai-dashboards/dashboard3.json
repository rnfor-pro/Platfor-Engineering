      {
        "id": 20,
        "type": "table",
        "title": "Recent Copilot Traces (search & drill into Tempo)",
        "description": "Searchable table of recent traces filtered by Model/Service. Span attribute names here assume Tempo preserves the same dotted gen_ai.* convention seen in VictoriaMetrics \u2014 verify against an actual span in Tempo's search UI before relying on this filter.",
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 68
        },
        "datasource": {
          "type": "tempo",
          "uid": "${DS_TEMPO_VAR}"
        },
        "targets": [
          {
            "queryType": "traceqlSearch",
            "filters": [
              {
                "id": "service-name",
                "tag": "service.name",
                "operator": "=~",
                "value": [
                  "$service_name"
                ],
                "valueType": "string"
              },
              {
                "id": "model",
                "tag": "gen_ai.request.model",
                "operator": "=~",
                "value": [
                  "$model"
                ],
                "valueType": "string"
              }
            ],
            "limit": 200,
            "tableType": "traces"
          }
        ],
        "options": {}
      },
