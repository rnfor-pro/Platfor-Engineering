      {
        "id": 15,
        "type": "timeseries",
        "title": "Input vs Output Tokens Over Time",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 40
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum(increase({__name__=\"gen_ai.client.token.usage_sum\", \"gen_ai.token.type\"=\"input\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}[1h]))",
            "legendFormat": "Input Tokens"
          },
          {
            "expr": "sum(increase({__name__=\"gen_ai.client.token.usage_sum\", \"gen_ai.token.type\"=\"output\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}[1h]))",
            "legendFormat": "Output Tokens"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "fillOpacity": 15,
              "lineWidth": 2
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Input Tokens"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#9C5FE0"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Output Tokens"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#5BA85B"
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "description": "Hourly trend of input vs. output token volume. A widening gap between input and output often signals growing context size (large files, long chat history) rather than longer answers."
      },
      {
        "id": 16,
        "type": "table",
        "title": "Estimated Cost by Model",
        "description": "Requires a cost-per-token recording rule or static multiplier; placeholder expression shown",
        "gridPos": {
          "h": 8,
          "w": 12,
