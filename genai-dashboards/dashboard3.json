        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "targets": [
          {
            "expr": "sum by (\"gen_ai.request.model\") ({__name__=\"gen_ai.client.token.usage_sum\", \"gen_ai.token.type\"=\"input\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}) * 0.000003 + sum by (\"gen_ai.request.model\") ({__name__=\"gen_ai.client.token.usage_sum\", \"gen_ai.token.type\"=\"output\", \"gen_ai.request.model\"=~\"$model\", service_name=~\"$service_name\"}) * 0.000015",
