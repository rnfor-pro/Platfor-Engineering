{
  "__inputs": [{"name":"DS_VICTORIAMETRICS","label":"VictoriaMetrics","type":"datasource","pluginId":"prometheus"}],
  "__requires": [
    {"type":"grafana","id":"grafana","name":"Grafana","version":"12.0.0"},
    {"type":"datasource","id":"prometheus","name":"Prometheus","version":"1.0.0"},
    {"type":"panel","id":"stat","name":"Stat","version":""},
    {"type":"panel","id":"timeseries","name":"Time series","version":""},
    {"type":"panel","id":"bargauge","name":"Bar gauge","version":""},
    {"type":"panel","id":"text","name":"Text","version":""}
  ],
  "uid": "copilot-otel-mcp-tools",
  "title": "Copilot — MCP Tool Call Analytics",
  "description": "MCP tool invocation counts, duration, and usage patterns from VS OTel instrumentation. Shows which tools developers are calling through Copilot agent mode.",
  "tags": ["copilot","otel","mcp","tools","agent"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1h",
  "time": {"from": "now-28d", "to": "now"},
  "graphTooltip": 1,
  "templating": {"list": [
    {
      "name": "tool",
      "type": "query",
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "query": "label_values(copilot_chat_tool_call_count, gen_ai_tool_name)",
      "refresh": 2,
      "multi": true,
      "includeAll": true,
      "allValue": ".*",
      "label": "Tool",
      "current": {}
    }
  ]},
  "panels": [
    {
      "id": 1, "type": "text", "title": "About This Dashboard",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "## Copilot MCP Tool Call Analytics\n\nMCP (Model Context Protocol) tool invocation data from Visual Studio OTel instrumentation. When developers use Copilot in agent mode, the agent calls tools to perform actions — file reads, code edits, terminal commands, web searches, and any MCP server tools the developer has configured.\n\n**Key concepts**\n- Each tool call is one discrete action the agent took during a session\n- Tool call duration shows how long each tool type takes to execute\n- High call counts for a specific tool indicate it is central to developer workflows\n- Use the **Tool** filter to focus on specific tools\n\n**Note:** No user attribution — these are enterprise totals from VS OTel. Source metrics: `copilot_chat_tool_call_count` and `copilot_chat_tool_call_duration_*`."}
    },
    {
      "id": 100, "type": "row", "title": "Tool Call Summary",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "collapsed": false
    },
    {
      "id": 2, "type": "stat", "title": "Total Tool Calls",
      "description": "Total number of MCP tool invocations by Copilot agent across the enterprise in the selected window. Each call is one discrete action the agent took. Source: copilot_chat_tool_call_count.",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sum(increase(copilot_chat_tool_call_count{gen_ai_tool_name=~\"$tool\"}[$__range]))", "legendFormat": "Total Tool Calls", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#3B82E6"}, "unit": "locale", "decimals": 0}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"}
    },
    {
      "id": 3, "type": "stat", "title": "Distinct Tools Used",
      "description": "Number of distinct MCP tools invoked across the enterprise in the selected window. A growing number indicates expanding MCP adoption and more diverse agent workflows.",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "count(sum by (gen_ai_tool_name) (increase(copilot_chat_tool_call_count[$__range])) > 0)", "legendFormat": "Distinct Tools", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#9C5FE0"}, "unit": "short", "decimals": 0}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"}
    },
    {
      "id": 4, "type": "stat", "title": "Avg Tool Call Duration (ms)",
      "description": "Average duration of MCP tool calls in milliseconds. Long average durations may indicate slow external MCP servers or network latency affecting agent responsiveness. Source: copilot_chat_tool_call_duration_sum / count.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "1000 * sum(increase(copilot_chat_tool_call_duration_sum{gen_ai_tool_name=~\"$tool\"}[$__range])) / clamp_min(sum(increase(copilot_chat_tool_call_duration_count{gen_ai_tool_name=~\"$tool\"}[$__range])), 1)", "legendFormat": "Avg Duration ms", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#F0954A"}, "unit": "ms", "decimals": 1}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"}
    },
    {
      "id": 5, "type": "stat", "title": "Tool Calls per Agent Session",
      "description": "Average number of tool calls per agent session. Higher values indicate agents are taking more steps to complete tasks — may reflect complex multi-step workflows or inefficient tool usage patterns.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sum(increase(copilot_chat_tool_call_count{gen_ai_tool_name=~\"$tool\"}[$__range])) / clamp_min(sum(increase(copilot_chat_agent_invocation_duration_count[$__range])), 1)", "legendFormat": "Calls per Session", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#5BA85B"}, "unit": "locale", "decimals": 1}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"}
    },
    {
      "id": 101, "type": "row", "title": "Tool Usage Breakdown",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 10}, "collapsed": false
    },
    {
      "id": 6, "type": "bargauge", "title": "Tool Calls by Tool Name",
      "description": "Total invocation count per MCP tool over the selected window. The most-called tools are central to developer workflows. Built-in tools like read_file, edit_file, and run_terminal_command typically dominate — custom MCP server tools appear here when developers have configured them.",
      "gridPos": {"h": 12, "w": 12, "x": 0, "y": 11},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sort_desc(sum by (gen_ai_tool_name) (increase(copilot_chat_tool_call_count{gen_ai_tool_name=~\"$tool\"}[$__range])))", "legendFormat": "{{gen_ai_tool_name}}", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "locale", "decimals": 0, "color": {"mode": "continuous-BlPu"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "mappings": []}},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "namePlacement": "left", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showUnfilled": true, "sizing": "auto", "minVizWidth": 8, "minVizHeight": 16, "maxVizHeight": 300},
      "transformations": []
    },
    {
      "id": 7, "type": "bargauge", "title": "Average Tool Duration by Tool Name (ms)",
      "description": "Average execution duration per tool in milliseconds. Slow tools create agent latency and reduce developer experience quality. Tools taking more than 2000ms on average should be investigated for performance issues in the underlying MCP server or network path.",
      "gridPos": {"h": 12, "w": 12, "x": 12, "y": 11},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sort_desc(1000 * sum by (gen_ai_tool_name) (increase(copilot_chat_tool_call_duration_sum{gen_ai_tool_name=~\"$tool\"}[$__range])) / clamp_min(sum by (gen_ai_tool_name) (increase(copilot_chat_tool_call_duration_count{gen_ai_tool_name=~\"$tool\"}[$__range])), 1))", "legendFormat": "{{gen_ai_tool_name}}", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1, "color": {"mode": "continuous-BlPu"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "mappings": []}},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "namePlacement": "left", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showUnfilled": true, "sizing": "auto", "minVizWidth": 8, "minVizHeight": 16, "maxVizHeight": 300},
      "transformations": []
    },
    {
      "id": 102, "type": "row", "title": "Tool Call Trends",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "collapsed": false
    },
    {
      "id": 8, "type": "timeseries", "title": "Daily Tool Call Volume",
      "description": "Total MCP tool invocations per day over the selected window. Rising trend indicates growing agent mode adoption across the enterprise. Dips on weekends are expected. Sudden spikes may indicate a new MCP server being adopted or a specific agent workflow becoming popular.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sum(increase(copilot_chat_tool_call_count{gen_ai_tool_name=~\"$tool\"}[1d]))", "legendFormat": "Tool Calls", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "locale", "color": {"mode": "fixed", "fixedColor": "#3B82E6"}, "custom": {"fillOpacity": 75, "lineWidth": 2}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Daily Tool Calls by Top Tools",
      "description": "Daily call volume per tool showing which tools are trending up or down over time. New tools appearing in the legend indicate developers are adopting additional MCP servers. Tools with declining usage may indicate workflow changes or tool quality issues.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "topk(10, sum by (gen_ai_tool_name) (increase(copilot_chat_tool_call_count{gen_ai_tool_name=~\"$tool\"}[1d])))", "legendFormat": "{{gen_ai_tool_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "locale", "custom": {"fillOpacity": 75, "lineWidth": 2}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "links": [
    {"title": "Token Economics", "url": "/d/copilot-otel-token-economics", "type": "link", "targetBlank": false},
    {"title": "Agent Performance", "url": "/d/copilot-otel-agent-performance", "type": "link", "targetBlank": false},
    {"title": "Code Survival", "url": "/d/copilot-otel-code-survival", "type": "link", "targetBlank": false},
    {"title": "Enterprise Overview", "url": "/d/copilot-enterprise-overview", "type": "link", "targetBlank": false}
  ]
}
