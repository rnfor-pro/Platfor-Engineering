{
  "__inputs": [
    { "name": "DS_VICTORIAMETRICS", "label": "VictoriaMetrics", "type": "datasource", "pluginId": "prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "uid": "copilot-enterprise-overview",
  "title": "Copilot — Enterprise Overview",
  "description": "Enterprise-wide GitHub Copilot usage metrics from VictoriaMetrics.",
  "tags": ["copilot", "enterprise", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1h",
  "time": { "from": "now-30d", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "enterprise",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
        "query": "label_values(github_copilot_daily_active_users, enterprise)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "label": "Enterprise",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "text", "title": "About This Dashboard",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## Copilot Enterprise Overview\n\nEnterprise-wide GitHub Copilot activity sourced from the GitHub Copilot exact-diff exporter. Data is collected daily from GitHub's metrics API and written to VictoriaMetrics. There is a 2-day lag — data visible today reflects activity up to 2 days ago.\n\n**Sections:** Activity Summary | Usage Trends | Feature and IDE Breakdown | Language Breakdown | Pull Request Impact | CLI Usage\n\nUse the **Enterprise** dropdown to switch between enterprise accounts. Use the time picker to change the reporting window."
      }
    },
    { "id": 100, "type": "row", "title": "Activity Summary", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false },
    {
      "id": 2, "type": "stat", "title": "Daily Active Users",
      "description": "Number of unique users who used at least one Copilot feature on the most recent available day. Source: github_copilot_daily_active_users.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "github_copilot_daily_active_users{enterprise=\"$enterprise\"}", "legendFormat": "Daily Active Users" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#3B82E6" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" }
    },
    {
      "id": 3, "type": "stat", "title": "Weekly Active Users",
      "description": "Unique users active on Copilot in the last 7 days as reported by GitHub. Source: github_copilot_weekly_active_users.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "github_copilot_weekly_active_users{enterprise=\"$enterprise\"}", "legendFormat": "Weekly Active Users" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#9C5FE0" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" }
    },
    {
      "id": 4, "type": "stat", "title": "Monthly Active Users",
      "description": "Unique users active on Copilot in the last 28 days as reported by GitHub. Source: github_copilot_monthly_active_users.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "github_copilot_monthly_active_users{enterprise=\"$enterprise\"}", "legendFormat": "Monthly Active Users" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#5BA85B" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" }
    },
    {
      "id": 5, "type": "stat", "title": "Total LOC Added",
      "description": "Total lines of AI-generated code accepted by all developers in the selected window. Source: github_copilot_loc_added_sum.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum(increase(github_copilot_loc_added_sum{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "LOC Added" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#5BA85B" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 6, "type": "stat", "title": "Code Acceptance Rate",
      "description": "Ratio of code acceptance activities to code generation activities across the enterprise. Higher values indicate developers are accepting more AI suggestions. Source: github_copilot_code_acceptance_activity_count / github_copilot_code_generation_activity_count.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "100 * sum(increase(github_copilot_code_acceptance_activity_count{enterprise=\"$enterprise\"}[$__range])) / clamp_min(sum(increase(github_copilot_code_generation_activity_count{enterprise=\"$enterprise\"}[$__range])), 1)", "legendFormat": "Acceptance Rate" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "#E0524A", "value": null }, { "color": "#F0954A", "value": 20 }, { "color": "#5BA85B", "value": 35 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 7, "type": "stat", "title": "Monthly Active Chat Users",
      "description": "Users who used Copilot Chat specifically in the last 28 days. Source: github_copilot_monthly_active_chat_users.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "github_copilot_monthly_active_chat_users{enterprise=\"$enterprise\"}", "legendFormat": "Active Chat Users" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#F0954A" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" }
    },
    { "id": 101, "type": "row", "title": "Usage Trends", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }, "collapsed": false },
    {
      "id": 8, "type": "timeseries", "title": "Active Users Over Time",
      "description": "Trend of daily, weekly, and monthly active users. A rising trend indicates growing adoption. Gaps may reflect weekends or GitHub API data lag. Source: github_copilot_daily/weekly/monthly_active_users.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [
        { "expr": "github_copilot_daily_active_users{enterprise=\"$enterprise\"}", "legendFormat": "Daily Active" },
        { "expr": "github_copilot_weekly_active_users{enterprise=\"$enterprise\"}", "legendFormat": "Weekly Active" },
        { "expr": "github_copilot_monthly_active_users{enterprise=\"$enterprise\"}", "legendFormat": "Monthly Active" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "Daily Active" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3B82E6" } }] },
        { "matcher": { "id": "byName", "options": "Weekly Active" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#9C5FE0" } }] },
        { "matcher": { "id": "byName", "options": "Monthly Active" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5BA85B" } }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "LOC Added and LOC Deleted Over Time",
      "description": "Daily trend of AI-generated lines accepted versus deleted. A large deletion count relative to additions may indicate low suggestion quality on certain days. Source: github_copilot_loc_added_sum and github_copilot_loc_deleted_sum.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [
        { "expr": "github_copilot_loc_added_sum{enterprise=\"$enterprise\"}", "legendFormat": "LOC Added" },
        { "expr": "github_copilot_loc_deleted_sum{enterprise=\"$enterprise\"}", "legendFormat": "LOC Deleted" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "LOC Added" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5BA85B" } }] },
        { "matcher": { "id": "byName", "options": "LOC Deleted" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E0524A" } }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    { "id": 102, "type": "row", "title": "Feature and IDE Breakdown", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }, "collapsed": false },
    {
      "id": 10, "type": "barchart", "title": "Interactions by Feature",
      "description": "Total user-initiated interactions broken out by Copilot feature over the selected window. Shows which surfaces developers use most. Source: github_copilot_feature_user_initiated_interaction_count.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum by (feature) (increase(github_copilot_feature_user_initiated_interaction_count{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "{{feature}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 11, "type": "barchart", "title": "LOC Added by Feature",
      "description": "Lines of AI-generated code accepted by developers segmented by Copilot feature. Source: github_copilot_feature_loc_added_sum.",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum by (feature) (increase(github_copilot_feature_loc_added_sum{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "{{feature}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 12, "type": "barchart", "title": "Interactions by IDE",
      "description": "User-initiated interactions broken out by IDE. Shows which development environments are driving Copilot usage across the enterprise. Source: github_copilot_ide_user_initiated_interaction_count.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum by (ide) (increase(github_copilot_ide_user_initiated_interaction_count{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "{{ide}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    { "id": 103, "type": "row", "title": "Language Breakdown", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 }, "collapsed": false },
    {
      "id": 13, "type": "barchart", "title": "Top Languages by LOC Added",
      "description": "Top 15 programming languages by AI-generated lines of code accepted. Reflects where developers are getting the most Copilot output value. Source: github_copilot_language_feature_loc_added_sum.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "topk(15, sum by (language) (increase(github_copilot_language_feature_loc_added_sum{enterprise=\"$enterprise\"}[$__range])))", "legendFormat": "{{language}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 14, "type": "barchart", "title": "Top Languages by Interactions",
      "description": "Top 15 programming languages generating the most Copilot interactions. Reflects where developers are most actively seeking AI assistance. Source: github_copilot_language_feature_code_generation_activity_count.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "topk(15, sum by (language) (increase(github_copilot_language_feature_code_generation_activity_count{enterprise=\"$enterprise\"}[$__range])))", "legendFormat": "{{language}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    { "id": 104, "type": "row", "title": "Pull Request Impact", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "collapsed": false },
    {
      "id": 15, "type": "stat", "title": "PRs Created by Copilot",
      "description": "Pull requests where Copilot was the primary author via the CLI agent. Source: github_copilot_pr_total_created_by_copilot.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum(increase(github_copilot_pr_total_created_by_copilot{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "PRs by Copilot" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#3B82E6" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 16, "type": "stat", "title": "PR Suggestions Applied",
      "description": "Number of Copilot code review suggestions that developers applied. High ratio of applied to total indicates useful review quality. Source: github_copilot_pr_total_copilot_applied_suggestions.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum(increase(github_copilot_pr_total_copilot_applied_suggestions{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "Applied Suggestions" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#5BA85B" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 17, "type": "stat", "title": "Median Minutes to Merge",
      "description": "Median time from PR creation to merge across all PRs. Compare to the Copilot-authored PR merge time to assess agent productivity. Source: github_copilot_pr_median_minutes_to_merge.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "avg(github_copilot_pr_median_minutes_to_merge{enterprise=\"$enterprise\"})", "legendFormat": "Minutes to Merge" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#F0954A" }, "unit": "m", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 18, "type": "stat", "title": "Copilot PR Median Minutes to Merge",
      "description": "Median time to merge specifically for PRs created by the Copilot agent. Compare to the overall median to assess whether agent-created PRs move faster or slower through review. Source: github_copilot_pr_median_minutes_to_merge_copilot_authored.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "avg(github_copilot_pr_median_minutes_to_merge_copilot_authored{enterprise=\"$enterprise\"})", "legendFormat": "Copilot PR Minutes" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#9C5FE0" }, "unit": "m", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 19, "type": "timeseries", "title": "PR Activity Over Time",
      "description": "Daily trend of total PRs created, PRs created by Copilot, and suggestions applied. Shows Copilot's growing contribution to the PR lifecycle over time. Source: github_copilot_pr_* metrics.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [
        { "expr": "github_copilot_pr_total_created{enterprise=\"$enterprise\"}", "legendFormat": "Total PRs Created" },
        { "expr": "github_copilot_pr_total_created_by_copilot{enterprise=\"$enterprise\"}", "legendFormat": "PRs by Copilot" },
        { "expr": "github_copilot_pr_total_copilot_applied_suggestions{enterprise=\"$enterprise\"}", "legendFormat": "Suggestions Applied" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    { "id": 105, "type": "row", "title": "CLI Usage", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 }, "collapsed": false },
    {
      "id": 20, "type": "stat", "title": "CLI Sessions",
      "description": "Total Copilot CLI sessions in the selected window. Each session is one terminal interaction sequence. Source: github_copilot_cli_session_count.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum(increase(github_copilot_cli_session_count{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "CLI Sessions" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#3B82E6" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 21, "type": "stat", "title": "CLI Prompts",
      "description": "Total Copilot CLI prompts submitted. Each prompt is one command or question submitted to the CLI agent. Source: github_copilot_cli_prompt_count.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum(increase(github_copilot_cli_prompt_count{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "CLI Prompts" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#9C5FE0" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 22, "type": "stat", "title": "CLI Output Tokens",
      "description": "Total tokens generated by the model in response to CLI prompts. Source: github_copilot_cli_output_tokens_sum.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "sum(increase(github_copilot_cli_output_tokens_sum{enterprise=\"$enterprise\"}[$__range]))", "legendFormat": "CLI Output Tokens" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#5BA85B" }, "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 23, "type": "stat", "title": "CLI Avg Tokens per Request",
      "description": "Average tokens generated per CLI request. Rising values indicate increasingly complex CLI tasks. Source: github_copilot_cli_avg_tokens_per_request.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "${DS_VICTORIAMETRICS}" },
      "targets": [{ "expr": "avg(github_copilot_cli_avg_tokens_per_request{enterprise=\"$enterprise\"})", "legendFormat": "Avg Tokens / Request" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#F0954A" }, "unit": "short", "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    }
  ],
  "links": [
    { "title": "Cohorts", "url": "/d/copilot-cohorts", "type": "link" },
    { "title": "Billing", "url": "/d/copilot-billing", "type": "link" },
    { "title": "User Self-Service", "url": "/d/copilot-user-selfservice", "type": "link" }
  ]
}
