  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 300,
      "type": "text",
      "title": "How to read this dashboard",
      "description": "High-level overview of what this dashboard measures and why it matters.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "## GitHub Copilot Code Generation & Delivery Impact\n\nThis dashboard focuses on how Copilot activity translates into **code changes, acceptance, and pull-request outcomes**.\n\n**Leadership:** quantify engineering impact and whether Copilot-supported activity is turning into accepted changes and delivered PRs.  \n**Teams:** see where feature, IDE, model, and language choices drive the most coding impact.  \n**Developers:** understand the relationship between generated suggestions, accepted suggestions, and code output.\n",
        "mode": "markdown"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Total lines added plus deleted with Copilot assistance over the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#79d26b",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "id": 301,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(github_copilot_loc_added_sum{enterprise=\"$enterprise\"}[$__range])) + sum(sum_over_time(github_copilot_loc_deleted_sum{enterprise=\"$enterprise\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "LoC Changed with AI",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Total number of Copilot code generation events over the selected time range.",
