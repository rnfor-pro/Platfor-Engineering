{"__inputs":[{"name":"DS_VICTORIAMETRICS","label":"VictoriaMetrics","type":"datasource","pluginId":"prometheus"}],"__requires":[{"type":"grafana","id":"grafana","name":"Grafana","version":"12.0.0"},{"type":"datasource","id":"prometheus","name":"Prometheus","version":"1.0.0"},{"type":"panel","id":"stat","name":"Stat","version":""},{"type":"panel","id":"timeseries","name":"Time series","version":""},{"type":"panel","id":"bargauge","name":"Bar gauge","version":""},{"type":"panel","id":"text","name":"Text","version":""}],"uid":"copilot-otel-code-survival","title":"Copilot \u2014 Code Survival and Quality","description":"Code survival rate from VS OTel \u2014 measures how much AI code developers keep. Most direct quality signal available.","tags":["copilot","otel","code","survival","quality"],"timezone":"browser","schemaVersion":39,"version":1,"refresh":"1h","time":{"from":"now-28d","to":"now"},"graphTooltip":1,"templating":{"list":[{"name":"model","type":"query","datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"query":"label_values({\"copilot_chat.edit.survival.no_revert_count\"}, \"gen_ai.request.model\")","refresh":2,"multi":true,"includeAll":true,"allValue":".*","label":"Model","current":{},"options":[]}]},"panels":[{"id":1,"type":"text","title":"About This Dashboard","gridPos":{"h":7,"w":24,"x":0,"y":0},"options":{"mode":"markdown","content":"## Copilot Code Survival and Quality\n\nThe most direct measure of AI code quality available \u2014 whether developers actually keep the code Copilot generates.\n\n| Metric | Measures | How to read |\n|---|---|---|\n| **No-revert rate** | % of AI edits NOT reverted | Higher = developers keep more AI code |\n| **4-gram survival** | % of 4-word code sequences from AI still in file after review | Higher = AI code was kept and not rewritten |\n\n**Why this matters:** The GitHub API counts lines accepted (LOC Added) but NOT whether the developer kept or immediately reverted that code. These OTel metrics close that gap \u2014 they are the ground truth on AI code quality.\n\n**Source metrics:** `copilot_chat.edit.survival.no_revert_*` and `copilot_chat.edit.survival.four_gram_*`"}},{"id":100,"type":"row","title":"Survival Rate Summary","gridPos":{"h":1,"w":24,"x":0,"y":7},"collapsed":false},{"id":2,"type":"stat","title":"No-Revert Rate","description":"% of AI edits NOT reverted. Target above 70%. Below 50% = model producing code developers frequently reject. Source: copilot_chat.edit.survival.no_revert.","gridPos":{"h":5,"w":6,"x":0,"y":8},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"100 * sum(increase({\"copilot_chat.edit.survival.no_revert_sum\", \"gen_ai.request.model\"=~\"$model\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.edit.survival.no_revert_count\", \"gen_ai.request.model\"=~\"$model\"}[$__range])), 1)","legendFormat":"No-Revert Rate","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","decimals":1,"thresholds":{"mode":"absolute","steps":[{"color":"#E0524A","value":null},{"color":"#F0954A","value":50},{"color":"#5BA85B","value":70}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":3,"type":"stat","title":"4-Gram Survival Rate","description":"% of 4-word AI code sequences still in codebase after review. Stronger quality signal than no-revert \u2014 measures long-term code retention. Source: copilot_chat.edit.survival.four_gram.","gridPos":{"h":5,"w":6,"x":6,"y":8},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"100 * sum(increase({\"copilot_chat.edit.survival.four_gram_sum\", \"gen_ai.request.model\"=~\"$model\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.edit.survival.four_gram_count\", \"gen_ai.request.model\"=~\"$model\"}[$__range])), 1)","legendFormat":"4-Gram Survival","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","decimals":1,"thresholds":{"mode":"absolute","steps":[{"color":"#E0524A","value":null},{"color":"#F0954A","value":40},{"color":"#5BA85B","value":60}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":4,"type":"stat","title":"Total Edits Measured","description":"Total AI edits for which survival was measured. Larger sample = higher confidence. Source: copilot_chat.edit.survival.no_revert_count.","gridPos":{"h":5,"w":6,"x":12,"y":8},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.edit.survival.no_revert_count\", \"gen_ai.request.model\"=~\"$model\"}[$__range]))","legendFormat":"Total Edits Measured","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#3B82E6"},"unit":"locale","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":5,"type":"stat","title":"Total 4-Gram Samples","description":"Total 4-gram code sequence samples measured. Source: copilot_chat.edit.survival.four_gram_count.","gridPos":{"h":5,"w":6,"x":18,"y":8},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.edit.survival.four_gram_count\", \"gen_ai.request.model\"=~\"$model\"}[$__range]))","legendFormat":"Total 4-Gram Samples","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#9C5FE0"},"unit":"locale","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":101,"type":"row","title":"Survival Trends","gridPos":{"h":1,"w":24,"x":0,"y":13},"collapsed":false},{"id":6,"type":"timeseries","title":"No-Revert Rate Over Time","description":"Daily no-revert rate. Rising = improving code quality or better model fit. Dips may coincide with model changes or task type shifts. Source: copilot_chat.edit.survival.no_revert.","gridPos":{"h":9,"w":12,"x":0,"y":14},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"100 * sum(rate({\"copilot_chat.edit.survival.no_revert_sum\", \"gen_ai.request.model\"=~\"$model\"}[1d])) / clamp_min(sum(rate({\"copilot_chat.edit.survival.no_revert_count\", \"gen_ai.request.model\"=~\"$model\"}[1d])), 0.001)","legendFormat":"No-Revert Rate %","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","custom":{"fillOpacity":75,"lineWidth":2}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}},{"id":7,"type":"timeseries","title":"4-Gram Survival Rate Over Time","description":"Daily 4-gram survival rate. Strongest quality signal \u2014 measures whether AI code sequences persist after developers review them. Source: copilot_chat.edit.survival.four_gram.","gridPos":{"h":9,"w":12,"x":12,"y":14},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"100 * sum(rate({\"copilot_chat.edit.survival.four_gram_sum\", \"gen_ai.request.model\"=~\"$model\"}[1d])) / clamp_min(sum(rate({\"copilot_chat.edit.survival.four_gram_count\", \"gen_ai.request.model\"=~\"$model\"}[1d])), 0.001)","legendFormat":"4-Gram Survival %","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","custom":{"fillOpacity":75,"lineWidth":2}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}},{"id":102,"type":"row","title":"Survival by Model","gridPos":{"h":1,"w":24,"x":0,"y":23},"collapsed":false},{"id":8,"type":"bargauge","title":"No-Revert Rate by Model","description":"Which models produce code developers keep most. A model with high token usage but low survival = expensive and low quality. Source: copilot_chat.edit.survival.no_revert grouped by gen_ai.request.model.","gridPos":{"h":10,"w":12,"x":0,"y":24},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sort_desc(100 * sum by (\"gen_ai.request.model\") (increase({\"copilot_chat.edit.survival.no_revert_sum\", \"gen_ai.request.model\"=~\"$model\"}[$__range])) / clamp_min(sum by (\"gen_ai.request.model\") (increase({\"copilot_chat.edit.survival.no_revert_count\", \"gen_ai.request.model\"=~\"$model\"}[$__range])), 1))","legendFormat":"{{gen_ai.request.model}}","refId":"A","instant":true}],"fieldConfig":{"defaults":{"unit":"percent","decimals":1,"color":{"mode":"continuous-BlPu"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"mappings":[]}},"options":{"orientation":"horizontal","displayMode":"gradient","valueMode":"color","namePlacement":"left","reduceOptions":{"calcs":["lastNotNull"],"values":false},"showUnfilled":true,"sizing":"auto","minVizWidth":8,"minVizHeight":16,"maxVizHeight":300},"transformations":[]},{"id":9,"type":"bargauge","title":"4-Gram Survival Rate by Model","description":"Which models produce code sequences that persist longest. This ranking should guide model recommendations for production code generation. Source: copilot_chat.edit.survival.four_gram grouped by gen_ai.request.model.","gridPos":{"h":10,"w":12,"x":12,"y":24},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sort_desc(100 * sum by (\"gen_ai.request.model\") (increase({\"copilot_chat.edit.survival.four_gram_sum\", \"gen_ai.request.model\"=~\"$model\"}[$__range])) / clamp_min(sum by (\"gen_ai.request.model\") (increase({\"copilot_chat.edit.survival.four_gram_count\", \"gen_ai.request.model\"=~\"$model\"}[$__range])), 1))","legendFormat":"{{gen_ai.request.model}}","refId":"A","instant":true}],"fieldConfig":{"defaults":{"unit":"percent","decimals":1,"color":{"mode":"continuous-BlPu"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"mappings":[]}},"options":{"orientation":"horizontal","displayMode":"gradient","valueMode":"color","namePlacement":"left","reduceOptions":{"calcs":["lastNotNull"],"values":false},"showUnfilled":true,"sizing":"auto","minVizWidth":8,"minVi