{"__inputs":[{"name":"DS_VICTORIAMETRICS","label":"VictoriaMetrics","type":"datasource","pluginId":"prometheus"}],"__requires":[{"type":"grafana","id":"grafana","name":"Grafana","version":"12.0.0"},{"type":"datasource","id":"prometheus","name":"Prometheus","version":"1.0.0"},{"type":"panel","id":"stat","name":"Stat","version":""},{"type":"panel","id":"timeseries","name":"Time series","version":""},{"type":"panel","id":"bargauge","name":"Bar gauge","version":""},{"type":"panel","id":"text","name":"Text","version":""}],"uid":"copilot-otel-mcp-tools","title":"Copilot \u2014 MCP Tool Call Analytics","description":"MCP tool invocation counts and duration from VS OTel. Metric names use dots as stored in VictoriaMetrics.","tags":["copilot","otel","mcp","tools"],"timezone":"browser","schemaVersion":39,"version":1,"refresh":"1h","time":{"from":"now-28d","to":"now"},"graphTooltip":1,"templating":{"list":[{"name":"tool","type":"query","datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"query":"label_values({\"copilot_chat.tool.call.count\"}, \"gen_ai.tool.name\")","refresh":2,"multi":true,"includeAll":true,"allValue":".*","label":"Tool","current":{},"options":[]}]},"panels":[{"id":1,"type":"text","title":"About This Dashboard","gridPos":{"h":5,"w":24,"x":0,"y":0},"options":{"mode":"markdown","content":"## Copilot MCP Tool Call Analytics\n\nMCP tool invocation data from Visual Studio OTel. When developers use Copilot in agent mode, the agent calls tools to perform actions \u2014 file reads, code edits, terminal commands, web searches, and any MCP server tools configured by the developer.\n\n**Source metrics:** `copilot_chat.tool.call.count` and `copilot_chat.tool.call.duration_sum/count`\n\n**Tool filter** \u2014 select specific tools to focus on. Built-in tools like `read_file`, `edit_file`, `run_terminal_command` typically dominate. Custom MCP server tools appear here when configured.\n\n**Note:** No user attribution \u2014 enterprise totals only."}},{"id":100,"type":"row","title":"Tool Call Summary","gridPos":{"h":1,"w":24,"x":0,"y":5},"collapsed":false},{"id":2,"type":"stat","title":"Total Tool Calls","description":"Total MCP tool invocations by Copilot agent. Each call is one discrete action. Source: copilot_chat.tool.call.count.","gridPos":{"h":4,"w":6,"x":0,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.tool.call.count\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range]))","legendFormat":"Total Tool Calls","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#3B82E6"},"unit":"locale","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":3,"type":"stat","title":"Distinct Tools Used","description":"Number of distinct MCP tools invoked. Growing count indicates expanding MCP adoption.","gridPos":{"h":4,"w":6,"x":6,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"count(sum by (\"gen_ai.tool.name\") (increase({\"copilot_chat.tool.call.count\"}[$__range])) > 0)","legendFormat":"Distinct Tools Used","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#9C5FE0"},"unit":"short","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":4,"type":"stat","title":"Avg Tool Call Duration (ms)","description":"Average duration of tool calls in ms. High values indicate slow MCP servers or network latency.","gridPos":{"h":4,"w":6,"x":12,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"1000 * sum(increase({\"copilot_chat.tool.call.duration_sum\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.tool.call.duration_count\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range])), 1)","legendFormat":"Avg Tool Call Duration (ms)","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#F0954A"},"unit":"ms","decimals":1}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":5,"type":"stat","title":"Tool Calls per Agent Session","description":"Average tool calls per agent session. Higher = more complex multi-step workflows.","gridPos":{"h":4,"w":6,"x":18,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.tool.call.count\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.agent.invocation.duration_count\"}[$__range])), 1)","legendFormat":"Tool Calls per Agent Session","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#5BA85B"},"unit":"locale","decimals":1}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":101,"type":"row","title":"Tool Usage Breakdown","gridPos":{"h":1,"w":24,"x":0,"y":10},"collapsed":false},{"id":6,"type":"bargauge","title":"Tool Calls by Tool Name","description":"Total invocation count per MCP tool. Most-called tools are central to developer workflows. Source: copilot_chat.tool.call.count grouped by gen_ai.tool.name.","gridPos":{"h":12,"w":12,"x":0,"y":11},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sort_desc(sum by (\"gen_ai.tool.name\") (increase({\"copilot_chat.tool.call.count\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range])))","legendFormat":"{{gen_ai.tool.name}}","refId":"A","instant":true}],"fieldConfig":{"defaults":{"unit":"locale","decimals":0,"color":{"mode":"continuous-BlPu"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"mappings":[]}},"options":{"orientation":"horizontal","displayMode":"gradient","valueMode":"color","namePlacement":"left","reduceOptions":{"calcs":["lastNotNull"],"values":false},"showUnfilled":true,"sizing":"auto","minVizWidth":8,"minVizHeight":16,"maxVizHeight":300},"transformations":[]},{"id":7,"type":"bargauge","title":"Avg Tool Duration by Tool Name (ms)","description":"Average execution duration per tool. Tools over 2000ms should be investigated for MCP server performance issues. Source: copilot_chat.tool.call.duration.","gridPos":{"h":12,"w":12,"x":12,"y":11},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sort_desc(1000 * sum by (\"gen_ai.tool.name\") (increase({\"copilot_chat.tool.call.duration_sum\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range])) / clamp_min(sum by (\"gen_ai.tool.name\") (increase({\"copilot_chat.tool.call.duration_count\", \"gen_ai.tool.name\"=~\"$tool\"}[$__range])), 1))","legendFormat":"{{gen_ai.tool.name}}","refId":"A","instant":true}],"fieldConfig":{"defaults":{"unit":"ms","decimals":1,"color":{"mode":"continuous-BlPu"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"mappings":[]}},"options":{"orientation":"horizontal","displayMode":"gradient","valueMode":"color","namePlacement":"left","reduceOptions":{"calcs":["lastNotNull"],"values":false},"showUnfilled":true,"sizing":"auto","minVizWidth":8,"minVizHeight":16,"maxVizHeight":300},"transformations":[]},{"id":102,"type":"row","title":"Tool Call Trends","gridPos":{"h":1,"w":24,"x":0,"y":23},"collapsed":false},{"id":8,"type":"timeseries","title":"Daily Tool Call Volume","description":"Total MCP tool invocations per day. Rising trend = growing agent mode adoption. Source: copilot_chat.tool.call.count.","gridPos":{"h":9,"w":12,"x":0,"y":24},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.tool.call.count\", \"gen_ai.tool.name\"=~\"$tool\"}[1d]))","legendFormat":"Tool Calls","refId":"A"}],"fieldConfig":{"defaults":{"unit":"locale","custom":{"fillOpacity":75,"lineWidth":2}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}},{"id":9,"type":"timeseries","title":"Daily Calls by Top Tools","description":"Daily call volume per tool showing which tools are trending. New tools indicate expanding MCP adoption.","gridPos":{"h":9,"w":12,"x":12,"y":24},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"topk(10, sum by (\"gen_ai.tool.name\") (increase({\"copilot_chat.tool.call.count\", \"gen_ai.tool.name\"=~\"$tool\"}[1d])))","legendFormat":"{{gen_ai.tool.name}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"locale","custom":{"fillOpacity":75,"lineWidth":2}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}}],"links":[{"title":"Token Economics","url":"/d/copilot-otel-token-economics","type":"link","targetBlank":false},{"title":"Agent Performance","url":"/d/copilot-otel-agent-performance","type":"link","targetBlank":false},{"title":"Code Survival","url":"/d/copilot-otel-code-survival","type":"link","targetBlank":false},{"title":"Enterprise Overview","url":"/d/copilot-enterprise-overview","type":"link","targetBlank":false}]}