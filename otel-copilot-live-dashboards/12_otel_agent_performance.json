{"__inputs":[{"name":"DS_VICTORIAMETRICS","label":"VictoriaMetrics","type":"datasource","pluginId":"prometheus"}],"__requires":[{"type":"grafana","id":"grafana","name":"Grafana","version":"12.0.0"},{"type":"datasource","id":"prometheus","name":"Prometheus","version":"1.0.0"},{"type":"panel","id":"stat","name":"Stat","version":""},{"type":"panel","id":"timeseries","name":"Time series","version":""},{"type":"panel","id":"bargauge","name":"Bar gauge","version":""},{"type":"panel","id":"text","name":"Text","version":""}],"uid":"copilot-otel-agent-performance","title":"Copilot \u2014 Agent and Session Performance","description":"Agent session counts, duration, turns, and latency from VS OTel. Metric names use dots.","tags":["copilot","otel","agent","session","latency"],"timezone":"browser","schemaVersion":39,"version":1,"refresh":"1h","time":{"from":"now-28d","to":"now"},"graphTooltip":1,"templating":{"list":[{"name":"service","type":"query","datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"query":"label_values({\"gen_ai.client.operation.duration_count\"}, service_name)","refresh":2,"multi":true,"includeAll":true,"allValue":".*","label":"Service","current":{},"options":[]},{"name":"model","type":"query","datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"query":"label_values({\"gen_ai.client.operation.duration_count\"}, \"gen_ai.request.model\")","refresh":2,"multi":true,"includeAll":true,"allValue":".*","label":"Model","current":{},"options":[]}]},"panels":[{"id":1,"type":"text","title":"About This Dashboard","gridPos":{"h":5,"w":24,"x":0,"y":0},"options":{"mode":"markdown","content":"## Copilot Agent and Session Performance\n\nAgent session metrics and response latency from Visual Studio OTel instrumentation.\n\n**Key metrics**\n- `copilot_chat.agent.invocation.duration` \u2014 total agent session duration\n- `copilot_chat.agent.turn.count` \u2014 turns per session\n- `copilot_chat.time_to_first_token` \u2014 latency to first response character\n- `gen_ai.client.time_per_output_chunk` \u2014 streaming speed\n- `copilot_chat.cloud.error.count` \u2014 failed agent operations\n\n**Note:** No user attribution \u2014 enterprise totals only."}},{"id":100,"type":"row","title":"Session Summary","gridPos":{"h":1,"w":24,"x":0,"y":5},"collapsed":false},{"id":2,"type":"stat","title":"Total Agent Sessions","description":"Total agent sessions started. Source: copilot_chat.agent.invocation.duration_count.","gridPos":{"h":4,"w":6,"x":0,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.agent.invocation.duration_count\"}[$__range]))","legendFormat":"Total Agent Sessions","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#3B82E6"},"unit":"locale","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":3,"type":"stat","title":"Avg Session Duration (s)","description":"Average agent session duration in seconds. Source: copilot_chat.agent.invocation.duration.","gridPos":{"h":4,"w":6,"x":6,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.agent.invocation.duration_sum\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.agent.invocation.duration_count\"}[$__range])), 1)","legendFormat":"Avg Session Duration (s)","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#9C5FE0"},"unit":"s","decimals":1}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":4,"type":"stat","title":"Avg Turns per Session","description":"Average turns per agent session. High counts may indicate complex tasks or agent struggling. Source: copilot_chat.agent.turn.count.","gridPos":{"h":4,"w":6,"x":12,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.agent.turn.count_sum\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.agent.turn.count_count\"}[$__range])), 1)","legendFormat":"Avg Turns per Session","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#F0954A"},"unit":"locale","decimals":1}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":5,"type":"stat","title":"Cloud Agent Errors","description":"Failed agent operations. Rising error count warrants investigation. Source: copilot_chat.cloud.error.count.","gridPos":{"h":4,"w":6,"x":18,"y":6},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.cloud.error.count\"}[$__range]))","legendFormat":"Cloud Agent Errors","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#E0524A"},"unit":"locale","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":101,"type":"row","title":"Response Latency","gridPos":{"h":1,"w":24,"x":0,"y":10},"collapsed":false},{"id":6,"type":"stat","title":"Avg Time to First Token (ms)","description":"Average ms from prompt to first response character. Key perceived latency metric. Source: copilot_chat.time_to_first_token.","gridPos":{"h":4,"w":8,"x":0,"y":11},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"1000 * sum(increase({\"copilot_chat.time_to_first_token_sum\", service_name=~\"$service\"}[$__range])) / clamp_min(sum(increase({\"copilot_chat.time_to_first_token_count\", service_name=~\"$service\"}[$__range])), 1)","legendFormat":"Avg Time to First Token (ms)","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#3B82E6"},"unit":"ms","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":7,"type":"stat","title":"Avg Time per Output Chunk (ms)","description":"Average ms between streamed output chunks. Controls streaming speed. Source: gen_ai.client.time_per_output_chunk.","gridPos":{"h":4,"w":8,"x":8,"y":11},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"1000 * sum(increase({\"gen_ai.client.time_per_output_chunk_sum\", service_name=~\"$service\"}[$__range])) / clamp_min(sum(increase({\"gen_ai.client.time_per_output_chunk_count\", service_name=~\"$service\"}[$__range])), 1)","legendFormat":"Avg Time per Output Chunk (ms)","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#9C5FE0"},"unit":"ms","decimals":1}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":8,"type":"stat","title":"Avg Total Operation Duration (ms)","description":"End-to-end latency per prompt from request to final response. Source: gen_ai.client.operation.duration.","gridPos":{"h":4,"w":8,"x":16,"y":11},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"1000 * sum(increase({\"gen_ai.client.operation.duration_sum\", service_name=~\"$service\"}[$__range])) / clamp_min(sum(increase({\"gen_ai.client.operation.duration_count\", service_name=~\"$service\"}[$__range])), 1)","legendFormat":"Avg Total Operation Duration (ms)","refId":"A"}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#5BA85B"},"unit":"ms","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":102,"type":"row","title":"Latency Trends","gridPos":{"h":1,"w":24,"x":0,"y":15},"collapsed":false},{"id":9,"type":"timeseries","title":"Time to First Token Over Time","description":"Daily avg TTFT in ms. Spikes = model or infrastructure latency. Source: copilot_chat.time_to_first_token.","gridPos":{"h":9,"w":12,"x":0,"y":16},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"1000 * sum(rate({\"copilot_chat.time_to_first_token_sum\", service_name=~\"$service\"}[1d])) / clamp_min(sum(rate({\"copilot_chat.time_to_first_token_count\", service_name=~\"$service\"}[1d])), 0.001)","legendFormat":"Avg TTFT ms","refId":"A"}],"fieldConfig":{"defaults":{"unit":"ms","custom":{"fillOpacity":75,"lineWidth":2}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}},{"id":10,"type":"timeseries","title":"Agent Session Count Over Time","description":"Daily agent session count. Rising trend = growing agent adoption. Source: copilot_chat.agent.invocation.duration_count.","gridPos":{"h":9,"w":12,"x":12,"y":16},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sum(increase({\"copilot_chat.agent.invocation.duration_count\"}[1d]))","legendFormat":"Agent Sessions","refId":"A"}],"fieldConfig":{"defaults":{"unit":"locale","custom":{"fillOpacity":75,"lineWidth":2}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}},{"id":103,"type":"row","title":"Latency by Model","gridPos":{"h":1,"w":24,"x":0,"y":25},"collapsed":false},{"id":11,"type":"bargauge","title":"Avg Time to First Token by Model (ms)","description":"TTFT per model. Faster models improve developer experience. Source: copilot_chat.time_to_first_token grouped by gen_ai.request.model.","gridPos":{"h":10,"w":12,"x":0,"y":26},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sort_desc(1000 * sum by (\"gen_ai.request.model\") (increase({\"copilot_chat.time_to_first_token_sum\", service_name=~\"$service\", \"gen_ai.request.model\"=~\"$model\"}[$__range])) / clamp_min(sum by (\"gen_ai.request.model\") (increase({\"copilot_chat.time_to_first_token_count\", service_name=~\"$service\", \"gen_ai.request.model\"=~\"$model\"}[$__range])), 1))","legendFormat":"{{gen_ai.request.model}}","refId":"A","instant":true}],"fieldConfig":{"defaults":{"unit":"ms","decimals":0,"color":{"mode":"continuous-BlPu"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"mappings":[]}},"options":{"orientation":"horizontal","displayMode":"gradient","valueMode":"color","namePlacement":"left","reduceOptions":{"calcs":["lastNotNull"],"values":false},"showUnfilled":true,"sizing":"auto","minVizWidth":8,"minVizHeight":16,"maxVizHeight":300},"transformations":[]},{"id":12,"type":"bargauge","title":"Avg Operation Duration by Model (ms)","description":"Total end-to-end latency per model. Higher may mean slower model or longer responses. Source: gen_ai.client.operation.duration grouped by gen_ai.request.model.","gridPos":{"h":10,"w":12,"x":12,"y":26},"datasource":{"type":"prometheus","uid":"${DS_VICTORIAMETRICS}"},"targets":[{"expr":"sort_desc(1000 * sum by (\"gen_ai.request.model\") (increase({\"gen_ai.client.operation.duration_sum\", service_name=~\"$service\", \"gen_ai.request.model\"=~\"$model\"}[$__range])) / clamp_min(sum by (\"gen_ai.request.model\") (increase({\"gen_ai.client.operation.duration_count\", service_name=~\"$service\", \"gen_ai.request.model\"=~\"$model\"}[$__range])), 1))","legendFormat":"{{gen_ai.request.model}}","refId":"A","instant":true}],"fieldConfig":{"defaults":{"unit":"ms","decimals":0,"color":{"mode":"continuous-BlPu"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"mappings":[]}},"options":{"orientation":"horizontal","displayMode":"gradient","valueMode":"color","namePlacement":"left","reduceOptions":{"calcs":["lastNotNull"],"values":false},"showUnfilled":true,"sizing":"auto","minVizWidth":8,"minVizHeight":16,"maxVizHeight":300},"transformations":[]}],"links":[{"title":"Token Economics","url":"/d/copilot-otel-token-economics","type":"link","targetBlank":false},{"title":"MCP Tool Analytics","url":"/d/copilot-otel-mcp-tools","type":"link","targetBlank":false},{"title":"Code Survival","url":"/d/copilot-otel-code-survival","type":"link","targetBlank":false},{"title":"Enterprise Overview","url":"/d/copilot-enterprise-overview","type":"link","targetBlank":false}]}