    {
      "id": 1,
      "type": "table",
      "title": "Downstream HTTP Operations",
      "description": "Lists client-side downstream operations issued by the AWCS services. These spans can identify external API calls, but endpoint-level detail depends on the attributes emitted by the application. Datasource: Tempo (non-prod).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_ds}"
          },
          "query": "{\n  resource.KEYSTONE_TENANT_ID = \"np-edps-aks\" &&\n  resource.epe_service_env = \"sit\" &&\n  resource.service.name =~ \"epe-awcs-mcleod.*\" &&\n  span:kind = client &&\n  name !~ \"GET /actuator/health/.*\"\n}",
          "queryType": "traceql",
          "limit": 200,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
