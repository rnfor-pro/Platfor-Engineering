  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Matching Trace Count",
      "description": "Number of matching AWCS traces in the selected time range, excluding health checks. Datasource: Tempo (non-prod). Value is a row count of the underlying trace search results (Panel counts rows via calcs:['count'], fields:'' -- Grafana's stat panel counts whichever field it auto-selects; the unit/decimals override below forces that count to render as a plain integer regardless of which column was auto-selected, since the auto-selected column is often the Duration field and its 'ms' unit would otherwise be misapplied to the count).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_ds}"
          },
          "query": "{\n  resource.KEYSTONE_TENANT_ID = \"np-edps-aks\" &&\n  resource.epe_service_env = \"sit\" &&\n  resource.service.name =~ \"epe-awcs-mcleod.*\" &&\n  name !~ \"GET /actuator/health/.*\"\n}",
          "queryType": "traceql",
          "limit": 200,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Spans",
      "description": "Counts or lists spans explicitly marked as errors by OpenTelemetry. Datasource: Tempo (non-prod). Value is a row count of matching error spans (see Matching Trace Count description for why unit/decimals are forced here).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_ds}"
          },
          "query": "{\n  resource.KEYSTONE_TENANT_ID = \"np-edps-aks\" &&\n  resource.epe_service_env = \"sit\" &&\n  resource.service.name =~ \"epe-awcs-mcleod.*\" &&\n  name !~ \"GET /actuator/health/.*\" &&\n  span:status = error\n}",
          "queryType": "traceql",
          "limit": 200,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Longest Trace",
      "description": "Identifies the longest observed AWCS traces. This is intended for drill-down investigation and does not by itself identify the business bottleneck. Datasource: Tempo (non-prod).",
