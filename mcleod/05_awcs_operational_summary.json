{
  "id": null,
  "uid": "awcs-operational-summary",
  "title": "AWCS Operational Summary",
  "description": "Compact operational view using only telemetry currently available (Tempo + Loki). Tenant np-edps-aks, epe_service_env=sit. Excludes health-check spans (GET /actuator/health/**). Tenant is fixed to np-edps-aks and environment to epe_service_env=\"sit\" \u2014 no cross-tenant or cross-environment data is included. This dashboard does not claim order-level visibility and does not treat ServiceBus.complete spans as proof of complete transaction success.",
  "tags": [
    "awcs",
    "mcleod",
    "summary",
    "non-prod",
    "sit"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "tempo_ds",
        "type": "datasource",
        "query": "tempo",
        "label": "Tempo datasource",
        "description": "Primary trace datasource (Tempo, non-prod Grafana Enterprise). Defaults to uid adj4lmm0iyr5sf.",
        "current": {
          "text": "Tempo (non-prod)",
          "value": "adj4lmm0iyr5sf"
        },
        "options": [],
