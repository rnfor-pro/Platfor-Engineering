    {
      "id": 4,
      "type": "timeseries",
      "title": "AWCS Log Volume",
      "description": "Shows AWCS application log volume over time. Spikes may indicate increased traffic or repeated failures, but log volume is not equivalent to transaction volume. Datasource: Loki (existing non-prod instance). The query's sum(...) has no by(...) clause, so it intentionally collapses both services into one combined series; the legend name is set explicitly here so it doesn't render as the empty label set '{}'.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "sum(count_over_time(\n  {service_name=~\"epe-awcs-mcleod-intg-ms|epe-awcs-mcleod-order-update-intg-ms\"}[5m]\n))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "AWCS log volume (both services combined)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {}
    },
