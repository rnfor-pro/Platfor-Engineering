{
  "dashboard": {
    "uid": "awcs-transaction-trace-analysis",
    "title": "AWCS Transaction Trace Analysis",
    "description": "Trace-level investigation for AWCS McLeod message processing, downstream API calls, Service Bus activity, and business-processing spans. Datasource: Tempo (non-prod). Tenant np-edps-aks, epe_service_env=sit. Excludes health-check spans (GET /actuator/health/**). Tenant is fixed to np-edps-aks and environment to epe_service_env=\"sit\" \u2014 no cross-tenant or cross-environment data is included. Filters at top (Tenant/Environment/Service) are reference-only labels; the underlying TraceQL queries are fixed literals per the approved spec and are not re-parameterized, so existing query text is preserved exactly.",
    "tags": [
      "awcs",
      "mcleod",
      "tempo",
      "non-prod",
      "sit"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "30s",
        "1m",
        "5m",
        "15m"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "2d",
        "7d"
      ]
    },
    "refresh": "1m",
    "schemaVersion": 39,
    "version": 1,
    "templating": {
      "list": [
        {
          "name": "tempo_ds",
          "type": "datasource",
          "query": "tempo",
          "label": "Tempo datasource",
          "current": {
            "text": "Tempo (non-prod)",
            "value": "adj4lmm0iyr5sf"
          },
          "hide": 0,
          "description": "Primary trace datasource (Tempo, non-prod Grafana Enterprise). Defaults to uid adj4lmm0iyr5sf."
        },
        {
          "name": "loki_ds",
          "type": "datasource",
          "query": "loki",
          "label": "Loki datasource",
          "hide": 0,
          "description": "Existing non-prod Loki datasource. Select your org's non-prod Loki instance."
        },
        {
          "name": "tenant",
          "type": "textbox",
          "label": "Tenant (reference only)",
          "current": {
            "value": "np-edps-aks"
          },
          "query": "np-edps-aks",
          "hide": 0,
          "description": "KEYSTONE_TENANT_ID reference. Panel queries below use this value as a literal and are NOT re-parameterized by this box, per the 'do not modify existing queries' rule."
        },
        {
          "name": "environment",
          "type": "textbox",
          "label": "Environment (reference only)",
          "current": {
            "value": "sit"
          },
          "query": "sit",
          "hide": 0,
          "description": "epe_service_env reference. Panel queries below use this value as a literal."
        },
        {
          "name": "service",
          "type": "textbox",
          "label": "Service (reference only)",
          "current": {
            "value": "epe-awcs-mcleod.*"
          },
          "query": "epe-awcs-mcleod.*",
          "hide": 0,
          "description": "resource.service.name filter reference. Panel queries below use this value as a literal."
        },
        {
          "name": "trace_id",
          "type": "textbox",
          "label": "TraceId",
          "current": {
            "value": ""
          },
          "query": "",
          "hide": 0,
          "description": "Paste a TraceId here to filter panels that reference $trace_id."
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "links": [],
    "panels": [
      {
        "id": 1,
        "type": "table",
        "title": "AWCS Trace Search",
        "description": "Lists non-health-check traces emitted by the AWCS McLeod services for tenant np-edps-aks in the sit environment. This is the primary entry point for selecting a real transaction TraceId. Datasource: Tempo (non-prod, uid adj4lmm0iyr5sf by default).",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 9
        },
        "datasource": {
          "type": "tempo",
          "uid": "${tempo_ds}"
        },
        "targets": [
          {
            "datasource": {
              "type": "tempo",
              "uid": "${tempo_ds}"
            },
            "query": "{\n  resource.KEYSTONE_TENANT_ID = \"np-edps-aks\" &&\n  resource.epe_service_env = \"sit\" &&\n  resource.service.name =~ \"epe-awcs-mcleod.*\" &&\n  name !~ \"GET /actuator/health/.*\"\n}",
            "queryType": "traceql",
            "limit": 200,
            "tableType": "traces",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {}
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "traceID"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "View trace in Tempo",
                      "url": "",
                      "targetBlank": false,
                      "internal": {
                        "datasourceUid": "${tempo_ds}",
                        "datasourceName": "Tempo",
                        "query": {
                          "query": "${__value.raw}",
                          "queryType": "traceql"
                        }
                      }
                    }
