{
  "dashboard": {
    "uid": "awcs-logs-trace-correlation",
    "title": "AWCS Logs and Trace Correlation",
    "description": "Loki-based application log investigation for AWCS McLeod services, with correlation to Tempo traces via TraceId. Datasource: Loki (existing non-prod instance \u2014 select it in the Loki datasource variable above). Services: epe-awcs-mcleod-intg-ms, epe-awcs-mcleod-order-update-intg-ms.",
    "tags": [
      "awcs",
      "mcleod",
      "loki",
      "non-prod",
      "sit"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "30s",
        "1m",
        "5m",
        "15m"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "2d",
        "7d"
      ]
    },
    "refresh": "1m",
    "schemaVersion": 39,
    "version": 1,
    "templating": {
      "list": [
        {
          "name": "tempo_ds",
          "type": "datasource",
          "query": "tempo",
          "label": "Tempo datasource",
          "current": {
            "text": "Tempo (non-prod)",
            "value": "adj4lmm0iyr5sf"
          },
          "hide": 0,
          "description": "Primary trace datasource (Tempo, non-prod Grafana Enterprise). Defaults to uid adj4lmm0iyr5sf."
        },
        {
          "name": "loki_ds",
          "type": "datasource",
          "query": "loki",
          "label": "Loki datasource",
          "hide": 0,
          "description": "Existing non-prod Loki datasource. Select your org's non-prod Loki instance."
        },
        {
          "name": "tenant",
          "type": "textbox",
          "label": "Tenant (reference only)",
          "current": {
            "value": "np-edps-aks"
          },
          "query": "np-edps-aks",
          "hide": 0,
          "description": "KEYSTONE_TENANT_ID reference. Panel queries below use this value as a literal and are NOT re-parameterized by this box, per the 'do not modify existing queries' rule."
        },
        {
          "name": "environment",
          "type": "textbox",
          "label": "Environment (reference only)",
          "current": {
            "value": "sit"
          },
          "query": "sit",
          "hide": 0,
          "description": "epe_service_env reference. Panel queries below use this value as a literal."
        },
        {
          "name": "service",
          "type": "textbox",
          "label": "Service (reference only)",
          "current": {
            "value": "epe-awcs-mcleod.*"
          },
          "query": "epe-awcs-mcleod.*",
          "hide": 0,
          "description": "resource.service.name filter reference. Panel queries below use this value as a literal."
        },
        {
          "name": "trace_id",
          "type": "textbox",
          "label": "TraceId",
          "current": {
            "value": ""
          },
          "query": "",
          "hide": 0,
          "description": "Paste a TraceId here to filter panels that reference $trace_id."
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "links": [],
    "panels": [
      {
        "id": 1,
        "type": "logs",
        "title": "AWCS Application Logs",
        "description": "Displays raw application logs for the two AWCS McLeod services. Loki is used for event context, messages, exceptions, and application details. Datasource: Loki (existing non-prod instance).",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 9
        },
        "datasource": {
          "type": "loki",
          "uid": "${loki_ds}"
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "${loki_ds}"
            },
            "expr": "{service_name=~\"epe-awcs-mcleod-intg-ms|epe-awcs-mcleod-order-update-intg-ms\"}",
            "queryType": "range",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {}
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "trace_id"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "View trace in Tempo",
                      "url": "",
                      "targetBlank": false,
                      "internal": {
                        "datasourceUid": "${tempo_ds}",
                        "datasourceName": "Tempo",
                        "query": {
                          "query": "${__value.raw}",
