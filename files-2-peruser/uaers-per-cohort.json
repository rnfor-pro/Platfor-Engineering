      {
        "id": 809,
        "title": "Users by Cohort \u2014 Full Username List",
        "type": "table",
        "description": "Each row is one user and their current AI adoption phase assignment. Sort by the 'AI Adoption Phase' column to group all users in the same cohort together. Use the Phase filter at the top to isolate a single cohort and export just those users. Source: github_copilot_user_ai_adoption_phase written daily per user.",
        "gridPos": {
          "h": 20,
          "w": 24,
          "x": 0,
          "y": 25
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "options": {
          "sortBy": [
            {
              "displayName": "AI Adoption Phase",
              "desc": false
            }
          ],
          "footer": {
            "show": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 0,
            "custom": {
              "align": "left"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "user_login"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Username"
                },
                {
                  "id": "custom.width",
                  "value": 220
                },
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "View user activity",
                      "url": "/d/copilot-ai-credit-by-user?var-enterprise=${__data.fields.enterprise}&var-user_login=${__value.raw}",
                      "targetBlank": false
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "ai_adoption_phase"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "AI Adoption Phase"
                },
                {
                  "id": "custom.width",
                  "value": 200
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "phase_0": {
                          "text": "\ud83d\udd18  Phase 0 \u2014 No Cohort",
                          "color": "gray",
                          "index": 0
                        },
                        "phase_1": {
                          "text": "\ud83d\udd35  Phase 1 \u2014 Code First",
                          "color": "blue",
                          "index": 1
                        },
                        "phase_2": {
                          "text": "\ud83d\udfe2  Phase 2 \u2014 Agent First",
                          "color": "green",
                          "index": 2
                        },
                        "phase_3": {
                          "text": "\ud83d\udfe3  Phase 3 \u2014 Multi-Agent",
                          "color": "purple",
                          "index": 3
                        },
                        "unknown": {
                          "text": "\ud83d\udfe0  Unknown",
                          "color": "orange",
                          "index": 4
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "gray",
                        "value": null
                      }
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "user_id"
              },
              "properties": [
                {
