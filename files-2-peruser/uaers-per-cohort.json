      {
        "id": 805,
        "title": "AI Adoption Phase Distribution \u2014 Daily",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 14,
          "x": 0,
          "y": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "targets": [
          {
            "expr": "sum by (ai_adoption_phase) (github_copilot_user_ai_adoption_phase{enterprise=\"$enterprise\",ai_adoption_phase=~\"$phase\"})",
            "legendFormat": "{{ai_adoption_phase}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "description": "Stacked bars show daily user count per phase. Growing Phase 2/3 bars indicate successful AI adoption progression.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "barAlignment": 0,
              "lineWidth": 1,
              "fillOpacity": 70,
              "stacking": {
                "mode": "normal",
                "group": "A"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "unit": "none",
            "decimals": 0
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "phase_0"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "gray",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "phase_1"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "cornflowerblue",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "phase_2"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "mediumseagreen",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "phase_3"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "mediumpurple",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "unknown"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "orange",
                    "mode": "fixed"
                  }
                }
