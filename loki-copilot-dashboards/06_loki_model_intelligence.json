":"${DS_LOKI}"},"targets":[{"expr":"count(sum by (user_login) (count_over_time({enterprise=\"$enterprise\", log_source=\"copilot_exporter\"} | json | used_cli=\"true\" [$__range])))","refId":"A","queryType":"instant","legendFormat":"","datasource":{"type":"loki","uid":"${DS_LOKI}"}}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#F0954A"},"unit":"short","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":5,"type":"stat","title":"Multi-Feature Users (28d)","description":"Users who used all three Copilot surfaces \u2014 chat, agent, and CLI \u2014 in the last 28 days. These are the most well-rounded Copilot users and strongest Phase 3 candidates.","gridPos":{"h":4,"w":6,"x":18,"y":6},"datasource":{"type":"loki","uid":"${DS_LOKI}"},"targets":[{"expr":"count(sum by (user_login) (count_over_time({enterprise=\"$enterprise\", log_source=\"copilot_exporter\"} | json | used_agent=\"true\" | used_cli=\"true\" | used_chat=\"true\" [$__range])))","refId":"A","queryType":"instant","legendFormat":"","datasource":{"type":"loki","uid":"${DS_LOKI}"}}],"fieldConfig":{"defaults":{"color":{"mode":"fixed","fixedColor":"#9C5FE0"},"unit":"short","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none","textMode":"value_and_name"}},{"id":101,"type":"row","title":"Feature Trends Over Time","gridPos":{"h":1,"w":24,"x":0,"y":10},"collapsed":false},{"id":6,"type":"timeseries","title":"Daily Active Users by Feature","description":"How many distinct users used each Copilot feature each day over the selected window. Rising agent and CLI lines indicate successful adoption deepening beyond basic completions.","gridPos":{"h":9,"w":24,"x":0,"y":11},"datasource":{"type":"loki","uid":"${DS_LOKI}"},"targets":[{"expr":"count(sum by (user_login) (count_over_time({enterprise=\"$enterprise\", log_source=\"copilot_exporter\"} | json | used_c