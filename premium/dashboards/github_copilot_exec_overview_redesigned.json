      "id": 107,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "github_copilot_daily_active_users{enterprise=\"$enterprise\"}",
          "legendFormat": "DAU",
          "refId": "A"
        },
        {
          "expr": "github_copilot_weekly_active_users{enterprise=\"$enterprise\"}",
          "legendFormat": "WAU",
          "refId": "B"
        },
        {
          "expr": "github_copilot_monthly_active_users{enterprise=\"$enterprise\"}",
          "legendFormat": "MAU",
          "refId": "C"
        }
      ],
      "title": "Adoption Trend",
      "type": "timeseries"
    },
